{
  "name": "@knowledge/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite",
    "desktop:build": "tauri build",
    "desktop:dev": "tauri dev",
    "lint": "eslint src --max-warnings 0",
    "test:smoke": "node ../../tests/desktop/editor-navigation-smoke.mjs",
    "test:canvas": "node --test ../../tests/desktop/canvas-spatial.test.mjs ../../tests/desktop/canvas-document.test.mjs",
    "test:search": "node --experimental-strip-types --test ../../tests/desktop/search-request.test.mjs",
    "test:r1a": "node --experimental-strip-types --test ../../tests/desktop/r1a-contracts.test.mjs",
    "test:r1a:ui": "node ../../tests/desktop/r1a-smoke.mjs",
    "test:r1b": "node --experimental-strip-types --test ../../tests/desktop/r1b-contracts.test.mjs",
    "test:r1b:ui": "node ../../tests/desktop/r1b-smoke.mjs",
    "test:r2a": "node --experimental-strip-types --test ../../tests/desktop/r2a-contracts.test.mjs",
    "test:r2a:ui": "node ../../tests/desktop/r2a-smoke.mjs",
    "test:r2b": "node --experimental-strip-types --test ../../tests/desktop/r2b-query.test.mjs ../../tests/desktop/r2b-task-query.test.mjs ../../tests/desktop/r2b-dataview.test.mjs ../../tests/desktop/r2b-capture-policy.test.mjs",
    "test:r2b:dql:ui": "node ../../tests/desktop/r2b-dataview-smoke.mjs",
    "test:r2b:capture:ui": "node ../../tests/desktop/r2b-capture-smoke.mjs",
    "test:r3a": "node --experimental-strip-types --test ../../tests/desktop/r3a-operations.test.mjs",
    "test:r3a:layout:ui": "node ../../tests/desktop/r3a-layout-smoke.mjs",
    "test:r2b:ui": "node ../../tests/desktop/r2b-properties-smoke.mjs",
    "test:r2b:tasks:ui": "node ../../tests/desktop/r2b-tasks-smoke.mjs",
    "test:r2b:tasks:scale": "node ../../tests/desktop/r2b-task-scale-smoke.mjs",
    "test:metadata:bench": "node ../../tests/desktop/metadata-benchmark.mjs",
    "test:cards:ui": "node ../../tests/desktop/canvas-card-ui-smoke.mjs",
    "test:render": "node ../../tests/desktop/canvas-render-smoke.mjs",
    "tauri": "tauri",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@lezer/highlight": "1.2.5",
    "@tauri-apps/api": "2.12.3",
    "@tauri-apps/plugin-dialog": "2.8.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
