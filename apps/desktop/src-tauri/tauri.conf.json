{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Brandon",
  "version": "0.1.0",
  "identifier": "dev.brandon.knowledge",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Brandon",
        "width": 1360,
        "height": 840,
        "minWidth": 840,
        "minHeight": 600,
        "decorations": false,
        "center": true,
        "shadow": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' asset: data: blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Local-first Markdown knowledge workspace",
    "copyright": "Copyright © 2026 Brandon contributors",
    "category": "Productivity"
  }
}
