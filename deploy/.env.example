# Public URL. Use a real DNS name; Caddy provisions TLS automatically.
KNOWLEDGE_SITE_ADDRESS=https://knowledge.example.com
KNOWLEDGE_PUBLIC_ORIGIN=https://knowledge.example.com
KNOWLEDGE_HTTP_PORT=80
KNOWLEDGE_HTTPS_PORT=443

# Absolute host paths to files containing exactly one secret value.
KNOWLEDGE_MASTER_KEY_FILE=/srv/knowledge/secrets/master_key
KNOWLEDGE_DATABASE_PASSWORD_FILE=/srv/knowledge/secrets/database_password
KNOWLEDGE_OBJECT_ACCESS_KEY_FILE=/srv/knowledge/secrets/object_access_key
KNOWLEDGE_OBJECT_SECRET_KEY_FILE=/srv/knowledge/secrets/object_secret_key
