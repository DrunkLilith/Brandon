{
    # Runtime HTTP errors also embed URI/headers even without access logging.
    # Keep non-HTTP startup/TLS diagnostics; request-correlated diagnostics live
    # in the backend's explicitly redacted operational events.
    log default {
        exclude http
    }
}

{$KNOWLEDGE_SITE_ADDRESS} {
    encode zstd gzip

    header {
        -Server
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Content-Security-Policy "default-src 'self'; connect-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }

    handle /api/* {
        reverse_proxy backend:3000
    }

    handle {
        reverse_proxy web:8080
    }
}
